+        assert_eq!(w.totals.revolts, 0);
+        assert_eq!(w.cells[1].capital, 0);
+    }
+    #[test]
+    fn winning_province_gains_independence_without_stock_transfer() {
+        let mut w = PolarityWorld::new(
+            PolarityConfig {
+                width: 2,
+                height: 2,
+                predator_share: 0.0,
+                initial_mean: 60.0,
+                initial_sd: 0.0,
+                harvest_mean: 0.0,
