+    #[test]
+    fn transient_stability_does_not_finish_session() {
+        let mut w = AuctionsWorld::new(
+            AuctionsConfig {
+                q_init: QInit::Biased,
+                bias_bid: 0.4,
+                bias_q: 30.0,
+                epsilon: 0.0,
+                horizon: 20,
+                window: 2,
+                periods_per_tick: 1,
+                ..Default::default()
+            },
+            1,
+        )
+        .unwrap();
+        w.run(5);
+        assert!(w.stable >= 2);
+        assert!(!w.is_finished());
