+    #[test]
+    fn short_native_fingerprints() {
+        let base = AuctionsConfig {
+            horizon: 23,
+            window: 5,
+            periods_per_tick: 7,
+            ..Default::default()
+        };
+        for (c, want) in [
+            base.clone(),
+            AuctionsConfig {
+                auction: Auction::SecondPrice,
+                ..base.clone()
+            },
+            AuctionsConfig {
+                feedback: Feedback::RivalBids,
+                update: Update::All,
+                ..base.clone()
+            },
+            AuctionsConfig {
+                fringe: Fringe::Uniform,
+                ..base.clone()
+            },
+            AuctionsConfig { bidders: 3, ..base },
+        ]
+        .into_iter()
+        .zip([
+            0x8736a8664d834a2du64,
+            0x1ba7cb1e9d3ff993,
+            0x949a7d400b127f20,
+            0x5f621ad6482502e7,
+            0x5c5c0013fee7f42b,
