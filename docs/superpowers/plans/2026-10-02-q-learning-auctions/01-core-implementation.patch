+        b.run(20);
+        assert_eq!(b.fingerprint(), before);
+    }
+    #[test]
+    fn unused_feedback_cannot_change_learning() {
+        for seed in 1..=10 {
+            let c = AuctionsConfig {
+                horizon: 101,
+                window: 5,
+                periods_per_tick: 7,
+                ..Default::default()
+            };
+            let mut a = AuctionsWorld::new(c.clone(), seed).unwrap();
+            let mut b = AuctionsWorld::new(
+                AuctionsConfig {
+                    feedback: Feedback::RivalBids,
+                    ..c
+                },
+                seed,
+            )
+            .unwrap();
+            a.run(15);
+            b.run(15);
