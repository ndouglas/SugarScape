+        "at": 1,
+        "name": "Other Q = 0",
+        "set": {
+          "bias_rest": 0
+        }
+      },
+      {
+        "at": 2,
+        "name": "Other Q = 29.7",
+        "set": {
+          "bias_rest": 29.7
+        }
+      }
+    ]
+  },
+  "seeds": {
+    "from": 1,
+    "count": 100
+  },
+  "ticks": 1000,
+  "metric": {
+    "kind": "final",
+    "series": "terminal_revenue"
+  },
+  "series": {
+    "label": "Auction",
+    "values": [
+      {
+        "at": 1,
+        "name": "First price",
+        "set": {
+          "auction": "first_price"
+        }
+      },
+      {
+        "at": 2,
+        "name": "Second price",
+        "set": {
+          "auction": "second_price"
+        }
+      }
+    ]
+  },
+  "set": {
