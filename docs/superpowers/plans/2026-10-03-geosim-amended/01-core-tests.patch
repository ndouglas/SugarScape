+    use super::*;
+    use crate::model::Model;
+    use rand::RngCore;
+    fn huge(threshold: f64, shift: f64, observation: u64, ppt: u32) -> GeosimConfig {
+        GeosimConfig {
+            width: 2,
+            height: 2,
+            initial_states: 1,
+            initialization_periods: 0,
+            observation_periods: observation,
+            periods_per_tick: ppt,
