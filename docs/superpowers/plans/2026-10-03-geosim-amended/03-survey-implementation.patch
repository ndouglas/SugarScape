+def contrast_verdict(estimate,adjusted_p):
+    if estimate is None or adjusted_p is None:return 'Unresolved'
+    if adjusted_p<.05 and estimate>0:return 'Holds'
+    if adjusted_p<.05 and estimate<0:return 'Fails'
+    return 'Inconclusive'
