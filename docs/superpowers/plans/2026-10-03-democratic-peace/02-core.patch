+    pub stale_claims: u64,
+    pub locked_claims: u64,
+    pub retired_states: u64,
+    pub released_states: u64,
+}
+pub(crate) fn bump(n: &mut u64) -> Result<(), String> {
+    *n = n.checked_add(1).ok_or("census counter overflow")?;
+    Ok(())
+}
