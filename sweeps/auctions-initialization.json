{
  "name": "Q-learning Auctions: initialization",
  "description": "Numerical optimistic initialization is unspecified in the paper. Sessions run to their fixed horizon; terminal stability and discarded sessions must be inspected separately. This is a reconstruction, not author-code docking.",
  "base": {
    "preset": "auctions-first-price"
  },
  "x": {
    "label": "Treatment",
    "values": [
      {
        "at": 1,
        "name": "Stage optimism",
        "set": {
          "q_init": "optimistic",
          "optimism": "stage"
        }
      },
      {
        "at": 2,
        "name": "Discounted optimism",
        "set": {
          "q_init": "optimistic",
          "optimism": "discounted"
        }
      },
      {
        "at": 3,
        "name": "Constant 2",
        "set": {
          "q_init": "constant",
          "q_level": 2
        }
      },
      {
        "at": 4,
        "name": "Constant 10",
        "set": {
          "q_init": "constant",
          "q_level": 10
        }
      },
      {
        "at": 5,
        "name": "Constant 100",
        "set": {
          "q_init": "constant",
          "q_level": 100
        }
      },
      {
        "at": 6,
        "name": "Constant 1000",
        "set": {
          "q_init": "constant",
          "q_level": 1000
        }
      }
    ]
  },
  "seeds": {
    "from": 1,
    "count": 100
  },
  "ticks": 1000,
  "metric": {
    "kind": "final",
    "series": "terminal_revenue"
  },
  "series": {
    "label": "Auction",
    "values": [
      {
        "at": 1,
        "name": "First price",
        "set": {
          "auction": "first_price"
        }
      },
      {
        "at": 2,
        "name": "Second price",
        "set": {
          "auction": "second_price"
        }
      }
    ]
  }
}
